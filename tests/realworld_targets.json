  "ua_routing": {
    "_note": [
      "2026-08-30 用户裁决后本块语义反转：全库已移除全部 USER-AGENT 规则（纯域名+IP 架构）。",
      "每条用例改为负向验证：带 UA 与不带 UA 的落点必须完全相同（expect_policy == baseline_policy），",
      "且命中表不得是任何 UA 规则。任何一条失败 = 有 UA 规则回流，应删规则本身。"
    ],
    "cases": [
      {
        "id": "ua_bili_to_direct",
        "host": "icanhazip.com",
        "url": "http://icanhazip.com/",
        "echo": "plain_ip",
        "ua": "bilibili/1.0",
        "baseline_ua": "curl/8.7.1",
        "expect_policy": "Final",
        "baseline_policy": "Final",
        "source_rule": "USER-AGENT,*bili* (ChinaMedia.list)",
        "desc": "负向验证：UA 规则已全删，该 UA 不得改变落点（=baseline）"
      },
