[
  {
    "name": "onedrive_personal_carveout_proxy",
    "desc": "R1-01 止血：OneDrive 个人版会话面全部走 Google-X-Meta-MS。CN 侧 onedrive.live.com 子树解析被投毒导致直连不可用；当前由 Microsoft.list 的显式子树认领，MicrosoftCN 只保留已验证的精确 live.com 主机/子树",
    "requests": [
      {"host": "onedrive.live.com", "note": "个人版 Web 入口"},
      {"host": "skyapi.onedrive.live.com", "note": "SkyDrive 遗留 API 端点，客户端同步用"},
      {"host": "photos.onedrive.live.com", "note": "相册面"},
      {"host": "snapshot.onedrive.live.com", "note": "缩略图/预览面"}
    ],
    "assert": {"same_policy": true, "policy": "Google-X-Meta-MS", "no_dns_leak": true}
  },
  {
    "name": "onedrive_carveout_no_overreach_direct",
