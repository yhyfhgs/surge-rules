[
  {
    "name": "browser_doh_canary_firefox",
    "desc": "Firefox DoH Canary 探测：use-application-dns.net 在无特定规则时落入 Final，由 Surge 决定是否允许浏览器接管 DoH",
    "requests": [
      {
        "host": "use-application-dns.net",
        "note": "Mozilla DoH canary 域名"
      }
    ],
    "assert": {
      "policy": "Final",
      "no_dns_leak": true
    }
  },
  {
    "name": "browser_doh_public_resolvers",
    "desc": "主流公共 DoH 解析器：Google/Cloudflare/AliDNS/DNSPod/360 差异化分流与防 DNS 泄漏",
    "requests": [
      {
        "host": "dns.google",
        "note": "Google DoH"
      },
      {
        "host": "cloudflare-dns.com",
        "note": "Cloudflare DoH"
      },
      {
        "host": "dns.alidns.com",
        "note": "阿里 DoH"
      },
      {
        "host": "doh.pub",
        "note": "腾讯 DNSPod DoH"
      },
      {
        "host": "doh.360.cn",
        "note": "360 安全 DoH"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "dns.google",
          "policy": "Google-X-Meta-MS",
          "reason": "Google.list 专有策略组"
        },
        {
          "host": "cloudflare-dns.com",
          "policy": "Proxy",
          "reason": "ProxyGFW.list 代理出站"
        },
        {
          "host": "dns.alidns.com",
          "policy": "DIRECT",
          "reason": "AlibabaCN.list 直连"
        },
        {
          "host": "doh.pub",
          "policy": "DIRECT",
          "reason": "TencentCN.list 直连"
        },
        {
          "host": "doh.360.cn",
          "policy": "DIRECT",
          "reason": "Domestic.list 直连"
        }
      ]
    }
  },
  {
    "name": "browser_webrtc_stun_matrix",
    "desc": "WebRTC STUN/TURN 服务器打洞与 NAT 探测矩阵：国内大厂直连、国外通讯服务走代理/社交",
    "requests": [
      {
        "host": "stun.qq.com",
        "note": "腾讯 WebRTC STUN"
      },
      {
        "host": "stun.miwifi.com",
        "note": "小米局域/公网 STUN"
      },
      {
        "host": "global.stun.twilio.com",
        "note": "Twilio WebRTC STUN"
      },
      {
        "host": "stun.zoom.us",
        "note": "Zoom WebRTC STUN"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "stun.qq.com",
          "policy": "DIRECT",
          "reason": "TencentCN 直连"
        },
        {
          "host": "stun.miwifi.com",
          "policy": "DIRECT",
          "reason": "PrivateLAN 直连"
        },
        {
          "host": "global.stun.twilio.com",
          "policy": "Proxy",
          "reason": "ProxyGFW 代理"
        },
        {
          "host": "stun.zoom.us",
          "policy": "社交媒体",
          "reason": "SocialOthers 策略组"
        }
      ]
    }
  },
