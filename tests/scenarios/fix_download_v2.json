    "requests": [
      {"host": "aws.cdn.hf.co", "note": "Xet CDN 族根；DOMAIN-SUFFIX 同时覆盖 us./eu. 等区域前缀"},
      {"host": "us.aws.cdn.hf.co", "note": "2026-08-31 实测 302 Location 的真实落点（模型 + 数据集两条路径一致）"},
      {"host": "eu.aws.cdn.hf.co", "note": "同族欧洲变体，当前无 A 记录但后缀已预覆盖，勿再逐个补录"},
      {"host": "cdn-lfs.hf.co", "note": "经典 LFS 端点；旧表只有 huggingface.co 形态（已死），hf.co 形态漏收"},
      {"host": "cdn-lfs-eu-1.hf.co"},
      {"host": "cdn-lfs-us-1.hf.co"},
      {"host": "xethub.hf.co", "note": "apex 无 A、SOA/NS 活（Route53），属子域型域，勿当死条目删"},
