[
  {
    "name": "collab_slack_realtime_messaging",
    "desc": "Slack 协同办公平台：客户端主站、边缘接入点、实时消息服务与表情图片 CDN",
    "requests": [
      {
        "host": "slack.com",
        "note": "Slack 官网与工作区"
      },
      {
        "host": "slack-edge.com",
        "note": "Slack Edge 边缘接入点"
      },
      {
        "host": "slack-msgs.com",
        "note": "Slack 实时消息传输"
      },
      {
        "host": "slack-imgs.com",
        "note": "Slack 附件与图片 CDN"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "社交媒体",
      "no_dns_leak": true
    }
  },
  {
    "name": "collab_zoom_video_conferencing",
