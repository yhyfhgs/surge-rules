  {
    "name": "collab_microsoft_teams_vs_office365",
    "desc": "微软办公协作分流：Teams 会议走海外专线，Office 365 / Office.com 走国内直连",
    "requests": [
      {
        "host": "teams.microsoft.com",
        "note": "Microsoft Teams 会议与协作网关 (Microsoft.list 代理)"
      },
      {
        "host": "office.com",
        "note": "Office 365 网页版 (MicrosoftCN.list 直连)"
      },
      {
        "host": "office365.com",
        "note": "Office 365 云端服务 (MicrosoftCN.list 直连)"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "teams.microsoft.com",
          "policy": "Google-X-Meta-MS",
          "reason": "Microsoft.list 代理"
        },
        {
          "host": "office.com",
          "policy": "DIRECT",
          "reason": "MicrosoftCN.list 国内直连"
        },
        {
          "host": "office365.com",
          "policy": "DIRECT",
          "reason": "MicrosoftCN.list 国内直连"
        }
      ]
    }
  },
