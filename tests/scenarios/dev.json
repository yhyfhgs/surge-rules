  {
    "name": "dev_vercel_edge_and_storage",
    "desc": "Vercel 前端云平台：主站走 Proxy 代理，框架 API 与 Blob 大文件存储走 DownloadCDN",
    "requests": [
      {
        "host": "vercel.com",
        "note": "Vercel 官网与控制台"
      },
      {
        "host": "api-frameworks.vercel.sh",
        "note": "Vercel 框架构建 API (DownloadCDN)"
      },
      {
        "host": "public.blob.vercel-storage.com",
        "note": "Vercel Blob 对象存储 (DownloadCDN)"
      },
      {
        "host": "openapi.vercel.sh",
        "note": "Vercel OpenAPI 规范 (DownloadCDN)"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "vercel.com",
          "policy": "Proxy",
          "reason": "ProxyGFW.list 代理出站"
        },
        {
          "host": "api-frameworks.vercel.sh",
          "policy": "下载",
          "reason": "DownloadCDN.list 下载加速"
        },
        {
          "host": "public.blob.vercel-storage.com",
          "policy": "下载",
          "reason": "DownloadCDN.list 下载加速"
        },
        {
          "host": "openapi.vercel.sh",
          "policy": "下载",
          "reason": "DownloadCDN.list 下载加速"
        }
      ]
    }
  },
