    "requests": [
      {"ip": "1.1.1.1", "note": "Cloudflare DNS，未被任何 IP 规则收录"},
      {"ip": "8.8.8.8", "note": "Google.list IP-CIDR,8.8.8.8/32"},
      {"ip": "8.8.4.4"},
      {"ip": "223.5.5.5", "note": "阿里 DNS，落 ChinaIP"},
      {"ip": "119.29.29.29", "note": "腾讯 DNSPod"},
      {"ip": "114.114.114.114"},
      {"ip": "104.244.42.1", "note": "Twitter 段"},
      {"ip": "149.154.167.51", "note": "Telegram DC 段"},
      {"ip": "160.79.104.10", "note": "Anthropic 160.79.104.0/21"},
      {"ip": "192.168.1.1", "note": "内网"},
      {"ip": "127.0.0.1", "note": "loopback"}
