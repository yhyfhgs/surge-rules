[
  {
    "name": "sentry_keyword_overcapture",
    "desc": "DOMAIN-KEYWORD,sentry / sift 的误伤面：官方站、租户 ingest 端点、第三方自建子域、以及同名无关公司。理想值＝按域名真实归属分流，不应被 AI 组吸走",
    "requests": [
      {
        "host": "sentry.io",
        "note": "Sentry 官方站，非 AI 服务"
      },
      {
        "host": "o447951.ingest.sentry.io",
        "note": "租户遥测 ingest（跟随宿主应用是可接受的）"
      },
      {
        "host": "sentryone.com",
        "note": "SolarWinds SentryOne，SQL Server 监控，与 AI 无关"
      },
      {
        "host": "sifted.eu",
        "note": "Sifted，欧洲创投媒体；被 DOMAIN-KEYWORD,sift 命中"
      },
      {
        "host": "sentry.example.com",
        "note": "RFC2606 保留域样本，代表任意网站自建的 sentry.<自有域>"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "sentry.io",
          "policy": "AI",
          "reason": "刻意保留：FIX-B 裁定 Sentry 官方域仍随 AI 组（AI 应用遥测），只把 DOMAIN-KEYWORD,sentry 收窄为 DOMAIN-SUFFIX,sentry.io + sentry-cdn.com。"
        },
        {
          "host": "o447951.ingest.sentry.io",
          "policy": "AI",
          "reason": "保留现状：AI 应用自带的遥测跟随 AI 组，可接受。"
        },
        {
          "host": "sentryone.com",
          "policy": "Final",
          "reason": "2026-08-25 F1 已修复：KEYWORD 收窄后不再误伤 SolarWinds SentryOne。"
        },
        {
          "host": "sifted.eu",
          "policy": "Final",
          "reason": "2026-08-25 F1 已修复：DOMAIN-KEYWORD,sift 收窄为 DOMAIN-SUFFIX,sift.com。"
        },
        {
          "host": "sentry.example.com",
          "policy": "Final",
          "reason": "2026-08-25 F1 已修复：任意站点自建 sentry.* 子域不再被吸入 AI 组。"
        }
      ]
    }
  },
  {
    "name": "domestic_ai_apps_pulled_into_proxy",
    "desc": "AI.list 直接收录的国内 AI 服务域：小爱同学、星野(MiniMax)、FastGPT。这些是纯国内服务，被 AI.list（远早于国内直连区）强制走美国出口",
    "requests": [
      {
        "host": "xiaoaiassist.com",
        "note": "小米小爱同学"
      },
      {
        "host": "xingyeai.com",
        "note": "MiniMax 星野"
      },
      {
        "host": "fastgpt.in",
        "note": "FastGPT（国内）"
      }
    ],
    "assert": {
      "same_policy": false,
      "per_request": [
        {
          "host": "xiaoaiassist.com",
          "policy": "DIRECT"
        },
        {
          "host": "xingyeai.com",
          "policy": "DIRECT"
        },
        {
          "host": "fastgpt.in",
          "policy": "AI"
        }
      ]
    },
    "note": "2026-08-25 F1：xiaoaiassist.com 与 xingyeai.com 已自 AI.list 移入 Domestic.list。advisor 裁决：fastgpt.in 是 .in 国际站域名，按「国内厂商国际站走代理」原则维持 AI 组（fastgpt.cn/run 国内域不受影响）。"
  },
