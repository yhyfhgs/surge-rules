  {
    "name": "process_name_case_variants",
    "desc": "PROCESS-NAME 大小写变体覆盖（00-context 声明为刻意跨平台设计），以及无进程时的兜底对照",
    "requests": [
      {"host": "example.com", "process": "Claude"},
      {"host": "example.com", "process": "claude"},
      {"host": "example.com", "process": "Claude.exe"},
      {"host": "example.com", "process": "claude.exe"},
      {"host": "example.com", "process": "Codex"},
      {"host": "example.com", "process": "Augment"},
      {"host": "example.com", "note": "无进程 → 落 FINAL"},
      {"host": "example.com", "process": "Antigravity", "note": "Google.list 的 PROCESS-NAME → Google-X-Meta-MS"}
    ],
    "assert": {
      "same_policy": false,
      "policy": "AI",
      "no_dns_leak": true,
      "per_request": [
        {"host": "example.com", "policy": "Final", "note": "无 process 的同名请求：per_request 按完整查询元组精确匹配，不会误伤上面带 process 的条目"},
        {"host": "example.com", "process": "Antigravity", "policy": "Google-X-Meta-MS"}
      ]
    }
  }
]
