[
  {
    "name": "sentry_keyword_overcapture",
    "desc": "DOMAIN-KEYWORD,sentry / sift 的误伤面：官方站、租户 ingest 端点、第三方自建子域、以及同名无关公司。理想值＝按域名真实归属分流，不应被 AI 组吸走",
    "requests": [
      {"host": "sentry.io", "note": "Sentry 官方站，非 AI 服务"},
      {"host": "o447951.ingest.sentry.io", "note": "租户遥测 ingest（跟随宿主应用是可接受的）"},
      {"host": "sentryone.com", "note": "SolarWinds SentryOne，SQL Server 监控，与 AI 无关"},
      {"host": "sifted.eu", "note": "Sifted，欧洲创投媒体；被 DOMAIN-KEYWORD,sift 命中"},
      {"host": "sentry.example.com", "note": "RFC2606 保留域样本，代表任意网站自建的 sentry.<自有域>"}
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {"host": "sentry.io", "policy": "AI", "reason": "刻意保留：FIX-B 裁定 Sentry 官方域仍随 AI 组（AI 应用遥测），只把 DOMAIN-KEYWORD,sentry 收窄为 DOMAIN-SUFFIX,sentry.io + sentry-cdn.com。"},
        {"host": "o447951.ingest.sentry.io", "policy": "AI", "reason": "保留现状：AI 应用自带的遥测跟随 AI 组，可接受。"},
        {"host": "sentryone.com", "policy": "Final", "reason": "2026-08-25 F1 已修复：KEYWORD 收窄后不再误伤 SolarWinds SentryOne。"},
        {"host": "sifted.eu", "policy": "Final", "reason": "2026-08-25 F1 已修复：DOMAIN-KEYWORD,sift 收窄为 DOMAIN-SUFFIX,sift.com。"},
        {"host": "sentry.example.com", "policy": "Final", "reason": "2026-08-25 F1 已修复：任意站点自建 sentry.* 子域不再被吸入 AI 组。"}
      ]
    }
  },
  {
    "name": "domestic_ai_apps_pulled_into_proxy",
    "desc": "AI.list 直接收录的国内 AI 服务域：小爱同学、星野(MiniMax)、FastGPT。这些是纯国内服务，被 AI.list（远早于国内直连区）强制走美国出口",
    "requests": [
      {"host": "xiaoaiassist.com", "note": "小米小爱同学"},
      {"host": "xingyeai.com", "note": "MiniMax 星野"},
      {"host": "fastgpt.in", "note": "FastGPT（国内）"}
    ],
    "assert": {
      "same_policy": false,
      "per_request": [
        {"host": "xiaoaiassist.com", "policy": "DIRECT"},
        {"host": "xingyeai.com", "policy": "DIRECT"},
        {"host": "fastgpt.in", "policy": "AI"}
      ]
    },
    "note": "2026-08-25 F1：xiaoaiassist.com 与 xingyeai.com 已自 AI.list 移入 Domestic.list。advisor 裁决：fastgpt.in 是 .in 国际站域名，按「国内厂商国际站走代理」原则维持 AI 组（fastgpt.cn/run 国内域不受影响）。"
  },
  {
    "name": "ocsp_crl_revocation_check",
    "desc": "证书吊销检查（OCSP/CRL）：握手关键路径，回归固化当前归属以防漂移",
    "requests": [
      {"host": "ocsp.digicert.com"},
      {"host": "ocsp.apple.com"},
      {"host": "ocsp2.apple.com"},
      {"host": "r3.o.lencr.org", "note": "Let's Encrypt OCSP"},
      {"host": "x1.c.lencr.org", "note": "Let's Encrypt 证书链分发"},
      {"host": "crl.microsoft.com"}
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {"host": "ocsp.digicert.com", "policy": "下载"},
        {"host": "ocsp.apple.com", "policy": "DIRECT"},
        {"host": "ocsp2.apple.com", "policy": "DIRECT"},
        {"host": "r3.o.lencr.org", "policy": "下载"},
        {"host": "x1.c.lencr.org", "policy": "下载"},
        {"host": "crl.microsoft.com", "policy": "Final"}
      ]
    }
  },
  {
    "name": "ntp_time_sync",
    "desc": "NTP 授时：conf 中 udp-policy-not-supported-behaviour=REJECT，NTP 走代理组等于被 REJECT，必须直连",
    "requests": [
      {"host": "time.apple.com"},
      {"host": "ntp.aliyun.com"},
      {"host": "cn.pool.ntp.org", "note": "国内 NTP 池"},
      {"host": "time.windows.com"}
    ],
    "assert": {"same_policy": true, "policy": "DIRECT"},
    "note": "2026-08-25 F1 已修复：pool.ntp.org / time.windows.com 自 DownloadCDN 移入 Domestic.list。"
  },
  {
    "name": "captive_portal_detection",
    "desc": "热点登录探测（captive portal）：必须直连，否则连不上公共 Wi-Fi 就无法弹出登录页",
    "requests": [
      {"host": "captive.apple.com", "note": "内置 SYSTEM 规则集"},
      {"host": "connect.rom.miui.com", "note": "conf 的 internet-test-url"},
      {"host": "www.msftconnecttest.com"},
      {"host": "detectportal.firefox.com"}
    ],
    "assert": {"same_policy": true, "policy": "DIRECT"},
    "note": "2026-08-25 F1 已修复：msftconnecttest.com / detectportal.firefox.com 自 DownloadCDN 移入 Domestic.list；同时移除 ProxyGFW.list 的 DOMAIN-SUFFIX,firefox.com（它会抢跑 detectportal，其余 firefox.com 主机改由 FINAL 兜底，策略组不变）。"
  },
  {
    "name": "stripe_payment_session",
    "desc": "Stripe 支付会话：Elements 脚本 + 支付 API + Checkout 页 + 风控信标。支付强依赖同出口 IP，跨出口易触发 3DS/拒付",
    "requests": [
      {"host": "js.stripe.com"},
      {"host": "api.stripe.com"},
      {"host": "checkout.stripe.com"},
      {"host": "q.stripe.com", "note": "遥测/风控信标"},
      {"host": "m.stripe.network", "note": "设备指纹/风控"}
    ],
    "assert": {"same_policy": true, "policy": "Final", "no_dns_leak": true},
    "note": "2026-08-25 F1 已修复：stripe.com 自 AI.list 移入 ProxyGFW.list，并补 stripe.network。"
  },
  {
    "name": "third_party_saas_captured_by_ai_list",
    "desc": "AI.list 收录的通用 SaaS 基础设施：Auth0 登录、Intercom 客服、LaunchDarkly 开关、Algolia 搜索、Cloudflare Turnstile。这些出现在成千上万个与 AI 无关的站点里",
    "requests": [
      {"host": "auth0.com"},
      {"host": "api-iam.intercom.io"},
      {"host": "js.intercomcdn.com"},
      {"host": "app.launchdarkly.com"},
      {"host": "events.launchdarkly.com"},
      {"host": "algolia.net"},
      {"host": "challenges.cloudflare.com", "note": "Turnstile，ChatGPT 登录会用到"}
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {"host": "auth0.com", "policy": "Final", "reason": "2026-08-25 F1 已修复：auth0.com 自 AI.list 移入 ProxyGFW.list。"},
        {"host": "api-iam.intercom.io", "policy": "AI", "reason": "刻意保留：FIX-B 裁定 intercom.io / intercomcdn.com 留在 AI 组（AI 产品内嵌客服组件，见 allowlist）。"},
        {"host": "js.intercomcdn.com", "policy": "AI", "reason": "同上。"},
        {"host": "app.launchdarkly.com", "policy": "Final", "reason": "2026-08-25 F1 已修复：launchdarkly.com 自 AI.list 删除，落 Final。"},
        {"host": "events.launchdarkly.com", "policy": "Final", "reason": "同上。"},
        {"host": "algolia.net", "policy": "Final", "reason": "2026-08-25 F1 已修复：algolia.net 自 AI.list 删除，落 Final。"},
        {"host": "challenges.cloudflare.com", "policy": "AI", "reason": "刻意保留：Turnstile 是 ChatGPT/Claude 登录链的一环，与 AI 同组反而有利（见 allowlist）。"}
      ]
    }
  },
  {
    "name": "pure_ip_requests",
