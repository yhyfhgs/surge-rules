        {"ip": "8.8.8.8", "policy": "Google-X-Meta-MS"},
        {"ip": "8.8.4.4", "policy": "Google-X-Meta-MS"},
        {"ip": "223.5.5.5", "policy": "DIRECT"},
        {"ip": "119.29.29.29", "policy": "DIRECT"},
        {"ip": "114.114.114.114", "policy": "DIRECT"},
        {"ip": "104.244.42.1", "policy": "Google-X-Meta-MS"},
        {"ip": "149.154.167.51", "policy": "Telegram"},
        {"ip": "160.79.104.10", "policy": "AI"},
        {"ip": "192.168.1.1", "policy": "DIRECT"},
        {"ip": "127.0.0.1", "policy": "DIRECT"}
      ]
    }
  },
  {
    "name": "user_vps_ip_asn",
