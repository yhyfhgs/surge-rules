[
  {
    "name": "deepseek_chat",
    "desc": "DeepSeek 网页对话 + 开放平台 API（国内服务必须全程直连，走代理反而更慢且可能被风控）",
    "requests": [
      {"host": "chat.deepseek.com"},
      {"host": "www.deepseek.com"},
      {"host": "api.deepseek.com"},
      {"host": "platform.deepseek.com"},
      {"host": "cdn.deepseek.com"}
    ],
    "assert": {"same_policy": true, "policy": "DIRECT"}
  },
