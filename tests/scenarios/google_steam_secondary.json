[
  {
    "name": "google_workspace_and_first_party_surfaces",
    "desc": "Google 官方 Workspace 与主要产品面使用显式子树规则，避免仅保留 google.com apex DOMAIN 导致二级服务落 FINAL。",
    "requests": [
      {"host": "calendar.google.com"},
      {"host": "chat.google.com"},
      {"host": "contacts.google.com"},
      {"host": "docs.google.com"},
      {"host": "drive.google.com"},
      {"host": "forms.google.com"},
      {"host": "groups.google.com"},
      {"host": "mail.google.com"},
      {"host": "meet.google.com"},
      {"host": "sheets.google.com"},
      {"host": "sites.google.com"},
      {"host": "slides.google.com"},
      {"host": "vids.google.com"},
      {"host": "workspace.google.com"},
      {"host": "maps.google.com"},
      {"host": "translate.google.com"},
      {"host": "photos.google.com"},
      {"host": "play.google.com"},
      {"host": "news.google.com"},
      {"host": "support.google.com"},
      {"host": "myaccount.google.com"}
    ],
    "assert": {"same_policy": true, "policy": "Google-X-Meta-MS", "no_dns_leak": true}
  },
  {
    "name": "google_cdn_youtube_and_apex_boundaries",
    "desc": "保留 Google、googleusercontent、ggpht apex DOMAIN；lh1-lh6 通用图片 CDN 归 Google，yt3/yt4 仍由 YouTube.list 认领，未知子域落 FINAL。",
    "requests": [
      {"host": "google.com"},
      {"host": "googleusercontent.com"},
      {"host": "ggpht.com"},
      {"host": "lh1.googleusercontent.com"},
      {"host": "lh2.googleusercontent.com"},
      {"host": "lh3.googleusercontent.com"},
      {"host": "lh4.googleusercontent.com"},
      {"host": "lh5.googleusercontent.com"},
      {"host": "lh6.googleusercontent.com"},
      {"host": "lh1.ggpht.com"},
      {"host": "lh2.ggpht.com"},
      {"host": "lh3.ggpht.com"},
      {"host": "lh4.ggpht.com"},
      {"host": "lh5.ggpht.com"},
      {"host": "lh6.ggpht.com"},
      {"host": "yt3.googleusercontent.com"},
      {"host": "yt4.googleusercontent.com"},
      {"host": "yt3.ggpht.com"},
      {"host": "yt4.ggpht.com"},
      {"host": "unknown.google.com"},
      {"host": "unknown.googleusercontent.com"},
      {"host": "unknown.ggpht.com"}
    ],
    "assert": {
      "no_dns_leak": true,
      "per_request": [
        {"host": "google.com", "policy": "Google-X-Meta-MS", "reason": "保留 DOMAIN,google.com apex"},
        {"host": "googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "保留 DOMAIN,googleusercontent.com apex"},
        {"host": "ggpht.com", "policy": "Google-X-Meta-MS", "reason": "保留 DOMAIN,ggpht.com apex"},
        {"host": "lh1.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh1.googleusercontent.com"},
        {"host": "lh2.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh2.googleusercontent.com"},
        {"host": "lh3.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh3.googleusercontent.com"},
        {"host": "lh4.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh4.googleusercontent.com"},
        {"host": "lh5.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh5.googleusercontent.com"},
        {"host": "lh6.googleusercontent.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh6.googleusercontent.com"},
        {"host": "lh1.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh1.ggpht.com"},
        {"host": "lh2.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh2.ggpht.com"},
        {"host": "lh3.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh3.ggpht.com"},
        {"host": "lh4.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh4.ggpht.com"},
        {"host": "lh5.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh5.ggpht.com"},
        {"host": "lh6.ggpht.com", "policy": "Google-X-Meta-MS", "reason": "DOMAIN-SUFFIX,lh6.ggpht.com"},
        {"host": "yt3.googleusercontent.com", "policy": "流媒体", "reason": "YouTube.list 的 yt3 精确归属优先于 Google"},
        {"host": "yt4.googleusercontent.com", "policy": "流媒体", "reason": "YouTube.list 的 yt4 精确归属优先于 Google"},
        {"host": "yt3.ggpht.com", "policy": "流媒体", "reason": "YouTube.list 的 yt3 精确归属优先于 Google"},
        {"host": "yt4.ggpht.com", "policy": "流媒体", "reason": "YouTube.list 的 yt4 精确归属优先于 Google"},
        {"host": "unknown.google.com", "policy": "Final", "reason": "apex DOMAIN 不扩展到未知子域"},
        {"host": "unknown.googleusercontent.com", "policy": "Final", "reason": "apex DOMAIN 不扩展到未知子域"},
        {"host": "unknown.ggpht.com", "policy": "Final", "reason": "apex DOMAIN 不扩展到未知子域"}
      ]
    }
  },
  {
    "name": "steam_secondary_and_cn_split",
    "desc": "Steam 国际帮助/主页/商店/API 归 Games；cm.steampowered.com 保持 GameDownloadCN 直连；未知 steampowered 子域不因 apex DOMAIN 被扩大捕获。",
    "requests": [
      {"host": "steampowered.com"},
      {"host": "help.steampowered.com"},
      {"host": "www.steampowered.com"},
      {"host": "store.steampowered.com"},
      {"host": "api.steampowered.com"},
      {"host": "cm.steampowered.com"},
      {"host": "unknown.steampowered.com"}
    ],
    "assert": {
      "no_dns_leak": true,
      "per_request": [
        {"host": "steampowered.com", "policy": "游戏", "reason": "Games.list DOMAIN,steampowered.com apex"},
        {"host": "help.steampowered.com", "policy": "游戏", "reason": "Games.list DOMAIN-SUFFIX,help.steampowered.com"},
        {"host": "www.steampowered.com", "policy": "游戏", "reason": "Games.list DOMAIN-SUFFIX,www.steampowered.com"},
        {"host": "store.steampowered.com", "policy": "游戏", "reason": "Games.list 既有 DOMAIN-SUFFIX,store.steampowered.com"},
        {"host": "api.steampowered.com", "policy": "游戏", "reason": "Games.list 既有 DOMAIN-SUFFIX,api.steampowered.com"},
        {"host": "cm.steampowered.com", "policy": "DIRECT", "reason": "GameDownloadCN.list 既有 DOMAIN-SUFFIX,cm.steampowered.com，位次早于 Games"},
        {"host": "unknown.steampowered.com", "policy": "Final", "reason": "steampowered.com apex DOMAIN 不扩展到未知子域"}
      ]
    }
  }
]
