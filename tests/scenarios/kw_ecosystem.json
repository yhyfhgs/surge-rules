  {
    "name": "kw_google_blogspot_gmail_recaptcha",
    "desc": "Google 三条宽关键词（blogspot/gmail/recaptcha）删除：自上游 Google 表恢复 73 条 blogspot ccTLD 后缀 + gmail.com + recaptcha.net；报告实证的 qingmail.com / suningmail.com 误捕获消除。recaptcha-cn.net 自 2026-08-31（advisor 裁决 7，`-cn` 族 18 条可迁）起改由 Domestic.list 直连承接，单列 per_request",
    "requests": [
      {
        "host": "gmail.com"
      },
      {
        "host": "mail.google.com",
        "note": "由既有 google.com 后缀承接"
      },
      {
        "host": "googlemail.com"
      },
      {
        "host": "blogspot.com"
      },
      {
        "host": "someblog.blogspot.com",
        "note": "用户博客子域"
      },
      {
        "host": "blogspot.co.uk",
        "note": "ccTLD 后缀"
      },
      {
        "host": "www.recaptcha.net",
        "note": "reCAPTCHA 全球可达端点"
      },
      {
        "host": "recaptcha-cn.net",
        "note": "reCAPTCHA 中国可达端点；2026-08-31 起归 Domestic.list 直连（CMNET 120.253/16 落点，与 .cn 族同一张 GTS 证书）"
      },
      {
        "host": "qingmail.com",
        "note": "负例：报告实证的 gmail 关键词误捕获"
      },
      {
        "host": "suningmail.com",
        "note": "负例：报告实证的 gmail 关键词误捕获"
      },
      {
        "host": "blogspotter.net",
        "note": "负例：含 blogspot 子串的第三方域"
      },
      {
        "host": "recaptcha-solver.io",
        "note": "负例：含 recaptcha 子串的第三方域"
      }
    ],
    "assert": {
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "gmail.com",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "mail.google.com",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "googlemail.com",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "blogspot.com",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "someblog.blogspot.com",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "blogspot.co.uk",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "www.recaptcha.net",
          "policy": "Google-X-Meta-MS"
        },
        {
          "host": "recaptcha-cn.net",
          "policy": "DIRECT",
          "reason": "advisor 裁决 7（`-cn` 族矩阵）：该端点在 CN 侧解析到中国移动 120.253.255.x 且证书 SAN 与 `.cn` 族同源，属境内可直连的 Google 中国面 —— 已从 Google.list 迁入 Domestic.list，落 DIRECT 属预期。"
        },
        {
          "host": "qingmail.com",
          "policy": "Final",
          "reason": "不再被 DOMAIN-KEYWORD,gmail 误捕获"
        },
        {
          "host": "suningmail.com",
          "policy": "Final",
          "reason": "不再被 DOMAIN-KEYWORD,gmail 误捕获"
        },
        {
          "host": "blogspotter.net",
          "policy": "Final"
        },
        {
          "host": "recaptcha-solver.io",
          "policy": "Final"
        }
      ]
    }
