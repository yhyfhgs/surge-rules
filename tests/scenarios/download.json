  {
    "name": "image_hosts_main_vs_cdn",
    "desc": "图床站：Imgur / Unsplash / Shopify 的主站与图片域",
    "note": "2026-08-25 F1：i.imgur.com 与 images.unsplash.com 已撤出 DownloadCDN，回到 GFW 兜底层。2026-09-01：ProxyGFW 改挂独立 Proxy 组，imgur/unsplash 期望由 Final 改为 Proxy；shopify 主域未命中 GFW、仍落 FINAL→Final，见 per_request。",
    "requests": [
      {"host": "imgur.com"},
      {"host": "i.imgur.com"},
      {"host": "unsplash.com"},
      {"host": "images.unsplash.com"},
      {"host": "www.shopify.com"},
      {"host": "cdn.shopify.com"}
    ],
    "assert": {
      "same_policy": true, "policy": "Proxy", "no_dns_leak": true,
      "per_request": [
        {"host": "cdn.shopify.com", "policy": "下载", "reason": "刻意保留：shopify.com 主域无 list 收录（靠 FINAL 兜底），不构成 FIX-D7 的同注册域分裂样本。"},
        {"host": "www.shopify.com", "policy": "Final", "reason": "2026-09-01 起 ProxyGFW 独立挂 Proxy 组（与收尾 FINAL 解耦）：本场景的 imgur / unsplash 命中 ProxyGFW 落 Proxy，而 shopify.com 主域不在 ProxyGFW（无任何表收录）仍落 FINAL→Final。两者分属不同站点，「同页并行引用需同组」的真实信号只在同一注册域内成立，故用 per_request 把它移出 same_policy 分组而非放宽断言。"}
      ]
    }
  },
