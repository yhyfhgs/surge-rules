[
  {
    "name": "public_js_cdn_cluster",
    "desc": "公共 JS/包 CDN 稳定归属：jsDelivr / unpkg / cdnjs 三家应同组（同一页面常并行引用）",
    "requests": [
      {"host": "cdn.jsdelivr.net"},
      {"host": "fastly.jsdelivr.net"},
      {"host": "unpkg.com"},
      {"host": "cdnjs.cloudflare.com"}
    ],
    "assert": {"same_policy": true, "policy": "下载", "no_dns_leak": true}
  },
  {
    "name": "google_fonts_and_ajax",
    "desc": "Google Fonts / Google Hosted Libraries：CSS 与字体文件必须同组（跨组会出现字体 CORS/缓存不一致）",
    "requests": [
      {"host": "fonts.googleapis.com", "note": "字体 CSS"},
      {"host": "fonts.gstatic.com", "note": "字体文件"},
      {"host": "ajax.googleapis.com", "note": "Hosted Libraries"}
    ],
    "assert": {"same_policy": true, "policy": "Google-X-Meta-MS", "no_dns_leak": true}
  },
  {
    "name": "gravatar_avatars",
    "desc": "Gravatar 头像：多个分片域名应同组",
    "requests": [
      {"host": "gravatar.com"},
      {"host": "www.gravatar.com"},
      {"host": "secure.gravatar.com"},
      {"host": "0.gravatar.com"}
    ],
    "assert": {"same_policy": true, "policy": "下载", "no_dns_leak": true}
  },
  {
    "name": "stackoverflow_main_vs_cdn",
    "desc": "Stack Overflow：主站 HTML + sstatic 静态资源 + 代码块图片",
    "note": "2026-08-25 F1：stack.imgur.com 已随 imgur.com 撤出 DownloadCDN，回到 GFW 兜底层。2026-09-01：用户把 ProxyGFW 从 Final 改挂独立 Proxy 组，stackoverflow.com 与 imgur.com 均命中 ProxyGFW，故期望由 Final 改为 Proxy——2026-09-01 起 ProxyGFW 独立挂 Proxy 组（与收尾 FINAL 解耦）。",
    "requests": [
      {"host": "stackoverflow.com"},
      {"host": "cdn.sstatic.net"},
      {"host": "i.stack.imgur.com"}
    ],
    "assert": {
      "same_policy": true, "policy": "Proxy", "no_dns_leak": true,
      "per_request": [
        {"host": "cdn.sstatic.net", "policy": "下载", "reason": "刻意保留：sstatic.net 是 DownloadCDN 的独立注册域，不在 FIX-D7『同注册域 Final|下载 分裂』作用域内；DownloadCDN 分层的既有代价（见 allowlist）。"}
      ]
    }
  },
  {
