        "host": "cursor.com"
      },
      {
        "host": "www.cursor.com"
      },
      {
        "host": "api2.cursor.sh",
        "note": "推理/补全后端"
      },
      {
        "host": "cursor-cdn.com",
        "note": "更新包 CDN"
      },
      {
        "host": "anysphere.co"
