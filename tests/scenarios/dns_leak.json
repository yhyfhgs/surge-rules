[
  {
    "name": "dnsleak_ai_group_domains",
    "desc": "DNS 泄漏专项 · 第 1 组（AI 组代理域 10 个）：断言匹配路径上不存在缺 no-resolve 的 IP 类规则。一旦某条 IP 规则丢了 no-resolve，这些域名就会先被国内 DNS(223.5.5.5/119.29.29.29)解析，等于把访问 AI 服务的意图暴露给国内递归",
    "requests": [
      {
        "host": "chatgpt.com"
      },
      {
        "host": "api.openai.com"
      },
      {
        "host": "claude.ai"
      },
      {
        "host": "api.anthropic.com"
      },
      {
        "host": "www.perplexity.ai"
      },
      {
        "host": "chat.mistral.ai"
      },
      {
        "host": "huggingface.co"
      },
      {
        "host": "api.groq.com"
      },
      {
        "host": "openrouter.ai"
      },
      {
        "host": "poe.com"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "AI",
      "no_dns_leak": true
    }
  },
