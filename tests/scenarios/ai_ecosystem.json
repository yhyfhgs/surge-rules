  },
  {
    "name": "microsoft_copilot_full_chain",
    "desc": "Microsoft Copilot：copilot.microsoft.com 登录（MSA/AAD）→ Bing 后端检索 → Office substrate 取上下文。理想上一次会话应同组同出口",
    "requests": [
      {
        "host": "copilot.microsoft.com"
      },
      {
        "host": "www.bing.com",
        "note": "检索后端"
      },
      {
        "host": "sydney.bing.com",
        "note": "Copilot 对话后端"
      },
      {
        "host": "edgeservices.bing.com"
      },
      {
        "host": "r.bing.com"
      },
      {
        "host": "login.microsoftonline.com",
        "note": "AAD 登录"
      },
      {
        "host": "login.live.com",
        "note": "MSA 登录"
      },
      {
        "host": "substrate.office.com",
        "note": "Office 上下文"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "Google-X-Meta-MS",
      "no_dns_leak": true
    },
    "note": "2026-08-25 架构调整：微软海外面自 AI.list 拆出为 Microsoft.list，随 Google/Twitter/Meta 走 Google-X-Meta-MS 组（大厂自有 AI 归各自生态）；GitHub 生态仍在 AI 组。"
  },
  {
    "name": "apple_intelligence_pcc",
    "desc": "Apple Intelligence / Private Cloud Compute：Siri 请求 + PCC 网关 + iCloud 私密中继",
    "requests": [
      {
        "host": "guzzoni.apple.com",
        "note": "Siri 后端"
      },
      {
        "host": "smoot.apple.com",
        "note": "Siri 建议/搜索"
      },
      {
        "host": "gateway.icloud.com",
        "note": "PCC/中继网关；2026-08-29 起归 AppleCN(DIRECT)"
      },
      {
        "host": "mask.icloud.com",
        "note": "iCloud Private Relay"
      },
      {
        "host": "mask-api.icloud.com"
      },
      {
        "host": "mask-h2.icloud.com"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "guzzoni.apple.com",
          "policy": "DIRECT",
          "reason": "刻意：国内 Siri 后端直连更快，随 AppleCN 走 DIRECT（见 allowlist）。"
        },
        {
          "host": "smoot.apple.com",
          "policy": "DIRECT",
          "reason": "同上。"
        },
        {
          "host": "gateway.icloud.com",
          "policy": "DIRECT",
          "reason": "2026-08-29 用户裁决（生态归属优先）：自 AI.list 摘除，由 AppleCN.list 的 DOMAIN-SUFFIX,icloud.com 接管直连。代价：Apple Intelligence(PCC) 大陆 IP 不受支持，功能将不可用；如需恢复，在 AI.list 重新加入 DOMAIN-SUFFIX,gateway.icloud.com 即可（AI 在 conf 96 先于 AppleCN 105）。"
        },
        {
          "host": "mask.icloud.com",
          "policy_in": [
            "DIRECT",
            "REJECT"
          ],
          "reason": "2026-08-25 F1 已从 AI.list 摘除；FIX-A2 在 conf 层显式 REJECT 后为 REJECT，conf 未落地时落 AppleCN 直连。"
        },
        {
          "host": "mask-api.icloud.com",
          "policy_in": [
            "DIRECT",
            "REJECT"
          ],
          "reason": "同上。"
        },
        {
          "host": "mask-h2.icloud.com",
          "policy_in": [
            "DIRECT",
            "REJECT"
          ],
          "reason": "同上。"
        }
      ]
    }
  }
]