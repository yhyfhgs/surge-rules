        "host": "colab.research.google.com"
      },
      {
        "host": "storage.googleapis.com",
        "note": "数据集读取"
      },
      {
        "host": "accounts.google.com"
      },
      {
        "host": "drive.google.com"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "Google-X-Meta-MS",
      "no_dns_leak": true
    }
  },
  {
    "name": "meta_ai_chat",
