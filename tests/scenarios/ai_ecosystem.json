      },
      {
        "host": "x.ai"
      },
      {
        "host": "grokipedia.com"
      },
      {
        "host": "x.com",
        "note": "X 内嵌 Grok 入口"
      },
      {
        "host": "api.x.com"
      },
      {
        "host": "abs.twimg.com"
      },
      {
        "host": "pbs.twimg.com",
        "note": "图片 CDN"
