[
  {
    "name": "google_gemini_full_chain",
    "desc": "Gemini 网页版全链：登录 Google 账号 → 对话 → 加载头像/静态资源。依据 00-context「大厂自有 AI 归各自生态」，全链应在 Google-X-Meta-MS 组",
    "requests": [
      {
        "host": "gemini.google.com"
      },
      {
        "host": "accounts.google.com",
        "note": "账号登录"
      },
      {
        "host": "apis.google.com"
      },
      {
        "host": "clients6.google.com",
        "note": "内部 RPC"
      },
      {
        "host": "ssl.gstatic.com"
      },
      {
        "host": "www.gstatic.com"
      },
      {
        "host": "lh3.googleusercontent.com",
        "note": "头像/图片"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "Google-X-Meta-MS",
      "no_dns_leak": true
    }
  },
  {
    "name": "google_ai_studio",
    "desc": "Google AI Studio：控制台 + Gemini API 后端 + 文档",
    "requests": [
      {
        "host": "aistudio.google.com"
      },
      {
        "host": "generativelanguage.googleapis.com",
        "note": "Gemini API 后端"
      },
      {
        "host": "ai.google.dev",
        "note": "开发者文档"
      },
      {
        "host": "accounts.google.com"
      },
      {
        "host": "www.gstatic.com"
      }
    ],
    "assert": {
      "same_policy": true,
      "policy": "Google-X-Meta-MS",
      "no_dns_leak": true
    }
  },
  {
    "name": "google_notebooklm",
