      },
      {
        "host": "myapp.pages.dev",
        "note": "任意 Cloudflare Pages 租户"
      },
      {
        "host": "mybucket.s3.amazonaws.com",
        "note": "任意 S3 bucket"
      },
      {
        "host": "abcdefghijkl.supabase.co",
        "note": "任意 Supabase 项目（含 Auth/DB API）"
      },
      {
        "host": "myapp.vercel.app",
        "note": "任意 Vercel 租户"
      },
      {
        "host": "myworker.workers.dev",
        "note": "任意 Cloudflare Worker"
