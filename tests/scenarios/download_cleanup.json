        "note": "任意 GitLab Pages 站点"
      },
      {
        "host": "myapp.netlify.app",
        "note": "任意 Netlify 应用（含 API / OAuth 回调）"
      },
      {
        "host": "myapp.now.sh",
        "note": "任意 Vercel 旧域应用"
      },
      {
