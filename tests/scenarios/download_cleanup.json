[
  {
    "name": "dlcdn_multitenant_suffixes_removed",
    "desc": "审计 P1-01：DownloadCDN 删除 13 条多租户托管平台宽后缀（任意租户共用同一后缀，后缀不代表业务所有者，更不代表「大流量批量下载」）。租户域不再被强制送下载出口，回落 Final；同表内真正的单一注册者下载域不受影响",
    "requests": [
      {
        "host": "mytenant.blob.core.windows.net",
        "note": "任意 Azure Blob 租户"
      },
      {
        "host": "d111111abcdef8.cloudfront.net",
        "note": "任意 CloudFront distribution"
      },
