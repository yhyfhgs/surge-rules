  },
  {
    "name": "wikipedia_article",
    "desc": "维基百科：条目页 + 图片/媒体（upload.wikimedia.org）+ 静态资源",
    "requests": [
      {"host": "en.wikipedia.org"},
      {"host": "zh.wikipedia.org"},
      {"host": "wikipedia.org"},
      {"host": "wikimedia.org"},
      {"host": "upload.wikimedia.org", "note": "条目内图片/媒体"}
