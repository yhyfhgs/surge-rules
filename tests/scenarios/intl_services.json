[
  {
    "name": "github_browse_and_clone",
    "desc": "GitHub 全链：浏览仓库 → 读 raw 文件 → 下载 release 资产 → git clone。理想上同组同出口（登录态 + LFS 分片）",
    "requests": [
      {"host": "github.com"},
      {"host": "gist.github.com"},
      {"host": "github.githubassets.com", "note": "前端静态资源"},
      {"host": "avatars.githubusercontent.com"},
      {"host": "raw.githubusercontent.com"},
      {"host": "objects.githubusercontent.com", "note": "release 资产"},
      {"host": "codeload.github.com", "note": "zip/tarball 下载"},
      {"host": "collector.github.com", "note": "前端遥测"}
    ],
    "assert": {"same_policy": true, "policy": "Google-X-Meta-MS", "no_dns_leak": true},
    "note": "2026-08-29 用户裁决（生态归属优先）：撤销 FIX-B，GitHub 平台域 10 条自 AI.list 迁入 Microsoft.list，整链仍同组同出口（登录态 + LFS 分片依赖此一致性），仅组别由 AI 变为 Google-X-Meta-MS。"
  },
  {
    "name": "netflix_watch",
    "desc": "Netflix 播放：主站 + 前端资源 + OCA 视频节点（流媒体解锁强依赖同出口）",
    "requests": [
      {"host": "www.netflix.com"},
      {"host": "netflix.com"},
      {"host": "occ-0-1723-1009.1.nflxso.net", "note": "前端/图片"},
      {"host": "nflxvideo.net"},
      {"host": "ipv4-c001-lax001-ix.1.oca.nflxvideo.net", "note": "OCA 视频节点"},
      {"host": "nflxext.com"},
      {"host": "assets.nflxext.com", "note": "海报/剧照资源"}
    ],
    "assert": {"same_policy": true, "policy": "流媒体", "no_dns_leak": true}
  },
  {
    "name": "spotify_playback",
    "desc": "Spotify 网页播放器：登录 + 元数据 + 封面 + 音频分发",
    "requests": [
      {"host": "open.spotify.com"},
      {"host": "spotify.com"},
      {"host": "accounts.spotify.com"},
      {"host": "spclient.wg.spotify.com", "note": "客户端 API"},
      {"host": "i.scdn.co", "note": "封面图"},
      {"host": "audio-fa.scdn.co", "note": "音频分发"}
    ],
    "assert": {"same_policy": true, "policy": "流媒体", "no_dns_leak": true}
  },
  {
    "name": "discord_chat_voice",
    "desc": "Discord：登录 → WebSocket 网关 → 附件 CDN → 媒体代理",
    "requests": [
      {"host": "discord.com"},
      {"host": "discordapp.com"},
      {"host": "gateway.discord.gg"},
      {"host": "cdn.discordapp.com"},
      {"host": "media.discordapp.net"},
      {"host": "discord.gg"}
    ],
    "assert": {"same_policy": true, "policy": "社交媒体", "no_dns_leak": true}
  },
  {
    "name": "reddit_browse",
    "desc": "Reddit：主站 + 图片 + 预览 + 样式资源",
    "requests": [
