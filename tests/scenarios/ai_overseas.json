  {
    "name": "github_copilot_oauth_chain",
    "desc": "GitHub Copilot：从 github.com 发起 OAuth → api.github.com 换 token → Copilot 补全 → 遥测上报。2026-08-30 用户裁决起整链同组：GitHub 平台面与 Copilot 推理面均归 Microsoft.list（四大厂 AI 归各自生态表）",
    "requests": [
      {
        "host": "github.com",
        "note": "OAuth 授权页"
      },
      {
        "host": "api.github.com",
        "note": "token 交换"
      },
      {
        "host": "api.githubcopilot.com",
        "note": "Copilot 推理端点"
      },
      {
        "host": "copilot-proxy.githubusercontent.com"
      },
      {
        "host": "copilot-telemetry.githubusercontent.com"
      }
    ],
    "assert": {
      "same_policy": false,
      "no_dns_leak": true,
      "per_request": [
        {
          "host": "github.com",
          "policy": "Google-X-Meta-MS",
          "reason": "2026-08-29 用户裁决：GitHub 平台域归 Microsoft.list（微软生态）。"
        },
        {
          "host": "api.github.com",
          "policy": "Google-X-Meta-MS",
          "reason": "同上，由 DOMAIN-SUFFIX,github.com 覆盖。"
        },
        {
          "host": "api.githubcopilot.com",
          "policy": "Google-X-Meta-MS",
          "reason": "2026-08-30 用户裁决：githubcopilot.com 迁入 Microsoft.list，Copilot 整链同组。"
        },
        {
          "host": "copilot-proxy.githubusercontent.com",
          "policy": "Google-X-Meta-MS",
          "reason": "githubusercontent.com 属平台静态面，随 Microsoft.list。"
        },
        {
          "host": "copilot-telemetry.githubusercontent.com",
          "policy": "Google-X-Meta-MS",
          "reason": "同上。"
        }
      ]
    },
    "note": "裁决沿革：2026-08-25 FIX-B（GitHub 全生态归 AI）→ 2026-08-29 生态归属优先（平台域归微软、推理面留 AI，刻意跨两组）→ 2026-08-30 用户裁决 Copilot 整链同组（githubcopilot.com/githubnext.com 亦入 Microsoft.list）。"
  },
