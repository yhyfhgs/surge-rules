#!name=模板模块 Template
#!desc=Surge 模块模板。各段语法与坑位说明齐备，所有指令默认注释态，安装后不产生任何行为。复制本文件改名后，取消需要的段的注释即可。
#!system=ios,mac

# ═══════════════════════════════════════════════════════════════════════════
#  元数据（#! 开头，必须位于文件顶部；Surge 只读这几个键，多余键会被忽略）
# ═══════════════════════════════════════════════════════════════════════════
#
#   #!name=        模块显示名。安装后在 Surge「模块」列表里就是这个名字，
#                  同名模块会互相覆盖，务必唯一。
#   #!desc=        一句话说明模块做什么。写清「改了什么 / 影响哪些域名」，
#                  半年后排障时能救命。支持 \n 换行。
#   #!system=      限定生效平台，逗号分隔，可选值：ios, mac, tvos。
#                  省略 = 全平台。只在 macOS 用的（如依赖本地端口的脚本）
#                  务必写 mac，避免在 iOS 上白占一份 MITM hostname。
#
# 以下为可选元数据，按需取消注释：
#
# #!category=自用            模块分组，Surge 列表里折叠显示
# #!author=yhyfhgs           作者署名
# #!homepage=https://github.com/yhyfhgs/surge-rules
# #!icon=https://example.com/icon.png
# #!date=2026-08-29          可写更新日期，便于判断新鲜度
#
# 模块参数（Surge 5+）：声明后用户可在模块详情页直接填，脚本里用 $argument 取。
# 声明顺序与 arguments-desc 的说明顺序需一一对应。
#
# #!arguments=token:,notify:true,interval:3600
# #!arguments-desc=token: 接口令牌，留空则跳过\nnotify: 是否推送通知\ninterval: 轮询间隔（秒）
#
# ═══════════════════════════════════════════════════════════════════════════
#  与主配置（Surge.conf）的关系 —— 动手前先读
# ═══════════════════════════════════════════════════════════════════════════
#
#  1. 优先级：模块的 [Rule] 会插到主配置 [Rule] 的**前面**。也就是说模块里
#     写一条 DOMAIN-SUFFIX 就能抢在本仓库全部 RULE-SET 之前生效。这是模块
#     最容易踩的坑 —— 只放「确实要凌驾于全局分流之上」的少量条目，
#     成体系的分流一律回 lists/ 里维护，别在模块里堆规则。
#
#  2. 零本地 DNS 解析（本仓库红线）：模块里任何 IP 类规则
#     （IP-CIDR / IP-CIDR6 / GEOIP / IP-ASN）都必须带 no-resolve，
#     否则会让一个未解析的域名请求触发本地 DNS 查询，破坏全链路约束。
#
#  3. MITM：模块的 hostname 必须用 %APPEND% 语义追加（见文末 [MITM] 段），
#     直接写 `hostname = xxx` 会**整体覆盖**主配置的 MITM 列表。
#     模块里**只写 hostname**。CA 证书本体与其解锁口令属于主配置和 GUI 运行态，
#     本仓库公开分发，任何证书材料写进来都等于当众交出私钥。
#
#  4. 调试：改完在 Surge 里「模块 → 长按 → 更新」重载；脚本改动还要看
#     「工具 → 脚本 → 脚本控制台」的日志与耗时。
#
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
#  [Script] —— 脚本挂载点
# ═══════════════════════════════════════════════════════════════════════════
#
#  通用写法： 脚本名 = type=<类型>,<参数>,script-path=<路径>
#  脚本名在「脚本控制台」里就是这个标识，取得有辨识度一点。
#
#  常用参数：
#    type=            http-request / http-response / cron / event / dns / generic
#    pattern=         仅 http-* 有效。匹配完整 URL 的正则，务必用 ^https?:// 起头
#                     并对 . 转义（写 example\.com，不要写 example.com）。
#    requires-body=1  仅 http-* 有效。不写这个，脚本里读不到 $request.body /
#                     $response.body（拿到的是 undefined）。
#    binary-body-mode=true  body 是二进制（protobuf / 图片）时开，
#                     此时 body 是 ArrayBuffer 而非字符串。
#    max-size=        body 超过该字节数就跳过脚本，默认 131072(128KB)。
#                     处理大 JSON 要调大，但越大越吃内存。
#    timeout=         脚本执行超时秒数，默认 5。脚本里发 $httpClient 请求的，
#                     这个值必须大于网络往返时间，否则请求会被判超时掐断。
#    argument=        传给脚本的参数串，脚本内用 $argument 读取。
#                     形如 key=value&key2=value2，值含特殊字符要 URL 编码。
#    engine=auto      JS 引擎选择，一般不用动。
#    debug=1          在控制台打印脚本的入参与耗时，联调时开，上线记得关。
#    enable=false     单独停用某条脚本而不删除。
#
#  ── 示例：改写请求（发出前）────────────────────────────────────────────
# 示例-请求改写 = type=http-request,pattern=^https?://example\.com/api/,requires-body=1,max-size=131072,timeout=10,script-path=https://cdn.jsdelivr.net/gh/yhyfhgs/surge-rules@main/scripts/_template.js,argument=debug=false
#
#  ── 示例：改写响应（返回前）────────────────────────────────────────────
# 示例-响应改写 = type=http-response,pattern=^https?://example\.com/api/v1/profile,requires-body=1,max-size=524288,timeout=10,script-path=https://cdn.jsdelivr.net/gh/yhyfhgs/surge-rules@main/scripts/_template.js,argument=debug=false
#
#  ── 示例：定时任务（签到 / 轮询）───────────────────────────────────────
#  cronexp 为 5 位 crontab 表达式，必须加引号；wake-system=1 允许唤醒设备执行。
# 示例-每日签到 = type=cron,cronexp="0 9 * * *",wake-system=1,timeout=60,script-path=https://cdn.jsdelivr.net/gh/yhyfhgs/surge-rules@main/scripts/_template.js,argument=notify=true
#
#  ── 示例：事件触发 ─────────────────────────────────────────────────────
#  event-name 可选：network-changed / network-updated / geo-updated 等。
# 示例-网络切换 = type=event,event-name=network-changed,timeout=15,script-path=https://cdn.jsdelivr.net/gh/yhyfhgs/surge-rules@main/scripts/_template.js
#
#  提示：script-path 也可写本地相对路径（相对 Profiles 目录），
#  例如 script-path=rules/scripts/_template.js —— 本地调试比走 CDN 快得多，
#  改完存盘即生效，不用等 jsDelivr 缓存过期。
[Script]


# ═══════════════════════════════════════════════════════════════════════════
#  [Rule] —— 模块级分流规则（会插到主配置 [Rule] 之前）
# ═══════════════════════════════════════════════════════════════════════════
#
#  语法与主配置完全一致：<类型>,<值>,<策略>[,修饰符]
#  策略可用 DIRECT / REJECT / REJECT-DROP / REJECT-TINYGIF，
#  或主配置里已存在的策略组名（组名写错会导致整个模块加载失败）。
#
#  ── 域名类：不触发 DNS，安全 ───────────────────────────────────────────
# DOMAIN,exact.example.com,DIRECT
# DOMAIN-SUFFIX,example.com,DIRECT
# DOMAIN-KEYWORD,example,REJECT
#
#  ── IP 类：必须带 no-resolve（本仓库红线，见文首第 2 条）────────────────
# IP-CIDR,203.0.113.0/24,DIRECT,no-resolve
# IP-CIDR6,2001:db8::/32,DIRECT,no-resolve
# GEOIP,CN,DIRECT,no-resolve
# IP-ASN,64496,DIRECT,no-resolve
#
#  ── 进程 / 端口 / 协议：适合按 App 精细分流 ────────────────────────────
#  同一个 App 在 iOS 与 macOS 上进程名大小写常不同，刻意写两行覆盖，
#  不要当成重复项去重（本仓库既定约定）。
# PROCESS-NAME,Example,DIRECT
# PROCESS-NAME,example,DIRECT
# DEST-PORT,853,REJECT
# PROTOCOL,UDP,REJECT
#
#  ── 逻辑组合：条件全中才生效 ───────────────────────────────────────────
# AND,((DOMAIN-SUFFIX,example.com),(DEST-PORT,443)),DIRECT
[Rule]


# ═══════════════════════════════════════════════════════════════════════════
#  [URL Rewrite] —— 重定向 / 拦截请求（作用于 URL，不解析 body）
# ═══════════════════════════════════════════════════════════════════════════
#
#  语法：<URL 正则> <目标或 -> <动作>
#  https 目标必须同时在 [MITM] 里追加 hostname，否则规则形同虚设。
#  正则匹配的是完整 URL；用 ^https?:// 起头，$ 收尾可避免误伤。
#
#  ── 302 / 307 重定向 ───────────────────────────────────────────────────
#  $1 $2 引用捕获组。307 保留原方法与 body（POST 不会被降级成 GET）。
# ^https?://old\.example\.com/(.*)$ https://new.example.com/$1 302
# ^https?://api\.example\.com/v1/(.*)$ https://api.example.com/v2/$1 307
#
#  ── header：只改 URL 不产生跳转（客户端无感，最常用于去参数）───────────
# ^https?://example\.com/feed\?.*utm_source=.* https://example.com/feed header
#
#  ── reject 系列：拦截请求，区别在返回什么 ──────────────────────────────
#    reject        直接断开（客户端可能报网络错误）
#    reject-200    返回 200 空响应，最「安静」，多数去广告场景用这个
#    reject-img    返回 1x1 透明图，适合图片位广告
#    reject-dict   返回 {}，适合期望 JSON 对象的接口
#    reject-array  返回 []，适合期望 JSON 数组的接口（如广告列表）
# ^https?://example\.com/track/ - reject-200
# ^https?://example\.com/ads/banner\.(png|jpg) - reject-img
# ^https?://example\.com/api/ads/list - reject-array
[URL Rewrite]


# ═══════════════════════════════════════════════════════════════════════════
#  [Map Local] —— 本地伪造响应（不发出真实请求）
# ═══════════════════════════════════════════════════════════════════════════
#
#  语法：<URL 正则> data-type=<类型> data="<内容>" [status-code=200] [header="..."]
#  比 URL Rewrite 的 reject 系列更可控：能自定义状态码、响应头与完整 body。
#  同样要求 https 域名已在 [MITM] 中。
#
#  data-type 取值：
#    text      data 直接写字面内容；内部的双引号要转义成 \"
#    base64    data 为 base64 串，适合塞二进制或含大量引号的内容
#    tiny-gif  返回内置 1x1 透明 GIF，data 可省略
#    file      data 为文件路径（相对 Profiles 目录），适合较大的 mock JSON
#
#  多个响应头用 | 分隔。
#
# ^https?://example\.com/api/config data-type=text data="{\"vip\":true,\"ad\":false}" status-code=200 header="Content-Type:application/json|Cache-Control:no-store"
# ^https?://example\.com/api/splash data-type=tiny-gif status-code=200
# ^https?://example\.com/api/bigmock data-type=file data="rules/modules/mock/bigmock.json" status-code=200 header="Content-Type:application/json"
[Map Local]


# ═══════════════════════════════════════════════════════════════════════════
#  [MITM] —— 解密范围声明
# ═══════════════════════════════════════════════════════════════════════════
#
#  只有列进 hostname 的域名，上面的 [Script](http-*) / [URL Rewrite](https 目标)
#  / [Map Local] 才可能生效。
#
#  ★ %APPEND% 语义（模块里必须用）：
#    hostname = %APPEND% a.com, *.b.com
#      → 把这些域名**追加**到主配置的 MITM 列表，不影响其它模块与主配置。
#    hostname = a.com
#      → **整体覆盖**主配置的 MITM 列表，会静默废掉其它所有模块的解密范围。
#    在 %APPEND% 列表里用前缀减号可反向排除某个域：
#      hostname = %APPEND% *.example.com, -pay.example.com
#
#  ★ 范围纪律：只写真正要处理的域，别写 *.com 之类的大通配。
#    MITM 面越大，性能开销、证书告警与「银行/支付 App 打不开」的风险越高。
#    支付、银行、企业 SSO、系统更新域一律排除。
#
#  ★ 红线：本段只允许出现 hostname 一项。CA 证书本体及其解锁口令只存在于
#    主配置与 GUI 运行态，任何情况下都不得写进模块文件（本仓库公开分发）。
#
# hostname = %APPEND% example.com, *.example.com, -pay.example.com
[MITM]


# ═══════════════════════════════════════════════════════════════════════════
#  其它可用段（本模板未展开，按需自行添加）
# ═══════════════════════════════════════════════════════════════════════════
#
#    [General]         模块级通用参数覆盖（如 skip-proxy、always-real-ip）
#    [Host]            静态 DNS 映射
#    [Header Rewrite]  增删改请求/响应头，比写脚本轻量得多
#    [Body Rewrite]    正则替换响应体（需 MITM + 谨慎使用，正则失误会砸掉页面）
#    [Panel]           在 Surge 首页显示自定义面板（配合 type=generic 脚本刷新）
#    [URL Rewrite] 之外还有 [Map Local]，二者对同一 URL 同时命中时以 Map Local 为准。
